<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/backgroundDark">

    <ImageButton
        android:id="@+id/deletefile"
        android:layout_width="63dp"
        android:layout_height="41dp"
        android:layout_marginStart="8dp"
        android:background="@color/backgroundDark"
        android:scaleType="centerCrop"
        android:src="@drawable/trashicon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/filename"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/openfolder"
        android:layout_width="79dp"
        android:layout_height="55dp"
        android:backgroundTint="@color/backgroundDark"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.913"
        app:layout_constraintStart_toEndOf="@+id/deletefile"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/foldericon" />

    <EditText
        android:id="@+id/filename"
        android:layout_width="238dp"
        android:layout_height="44dp"

        android:layout_marginStart="16dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </EditText>

</androidx.constraintlayout.widget.ConstraintLayout>